@prefix besluit: <http://data.vlaanderen.be/ns/besluit#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <http://w3id.org/ldes#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/ldes/unit-1/zittingen> a ldes:EventStream, tree:Collection ;
  tree:view <http://example.org/ldes/unit-1/zittingen/1> ;
  tree:shape <https://data.lblod.info/shacl/ldes-zitting#ZittingMemberShape> ;
  ldes:timestampPath prov:generatedAtTime ;
  ldes:versionOfPath dct:isVersionOf ;
  tree:member <http://mu.semte.ch/services/ldes-time-fragmenter/versioned/1> .
<http://example.org/ldes/unit-1/zittingen/1> a tree:Node .

# one member: the zitting with its nested resources
<http://mu.semte.ch/services/ldes-time-fragmenter/versioned/1> a besluit:Zitting ;
  dct:isVersionOf <http://ex.org/zitting/1> ;
  prov:generatedAtTime "2026-01-01T00:00:00.000Z"^^xsd:dateTime ;
  besluit:isGehoudenDoor <http://ex.org/orgaan-in-tijd/1> ;
  besluit:behandelt <http://ex.org/agendapunt/1> .
<http://ex.org/agendapunt/1> a besluit:Agendapunt ;
  dct:title "Budget"@nl .
<http://ex.org/behandeling/1> a besluit:BehandelingVanAgendapunt ;
  dct:subject <http://ex.org/agendapunt/1> ;
  besluit:heeftStemming <http://ex.org/stemming/1> .
<http://ex.org/stemming/1> a besluit:Stemming ;
  besluit:onderwerp "Budget" ;
  besluit:gevolg "aangenomen" .
