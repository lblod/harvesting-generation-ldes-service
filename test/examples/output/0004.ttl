@prefix besluit: <http://data.vlaanderen.be/ns/besluit#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <http://w3id.org/ldes#> .
@prefix as: <https://www.w3.org/ns/activitystreams#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix v: <http://mu.semte.ch/services/ldes-time-fragmenter/versioned/> .

# besluiten
<http://example.org/ldes/0004/besluiten> a ldes:EventStream, tree:Collection ;
  tree:view <http://example.org/ldes/0004/besluiten/1> ;
  tree:shape <https://data.lblod.info/shacl/ldes-besluit#BesluitMemberShape> ;
  ldes:timestampPath prov:generatedAtTime ;
  ldes:versionOfPath dct:isVersionOf ;
  tree:member v:1 .
<http://example.org/ldes/0004/besluiten/1> a tree:Node .
v:1 a besluit:Besluit ;
  dct:isVersionOf <http://ex.org/besluit/1> ;
  prov:generatedAtTime "2026-01-01T00:00:00.000Z"^^xsd:dateTime ;
  eli:title "Budget 2026" ;
  prov:wasGeneratedBy <http://ex.org/behandeling/1> ;
  prov:wasDerivedFrom <http://ex.org/besluitenlijst> ;
  eli:has_part <http://ex.org/artikel/1>, <http://ex.org/artikel/2> .
<http://ex.org/artikel/1> a besluit:Artikel ;
  eli:number "1" ;
  prov:value "Het budget wordt goedgekeurd." ;
  prov:wasDerivedFrom <http://ex.org/besluitenlijst> .
# artikel/2 has no prov:value: left out, the has_part link stays

# zittingen: stemming/1 has no gevolg: left out, the heeftStemming link stays
<http://example.org/ldes/0004/zittingen> a ldes:EventStream, tree:Collection ;
  tree:view <http://example.org/ldes/0004/zittingen/1> ;
  tree:shape <https://data.lblod.info/shacl/ldes-zitting#ZittingMemberShape> ;
  ldes:timestampPath prov:generatedAtTime ;
  ldes:versionOfPath dct:isVersionOf ;
  tree:member v:2 .
<http://example.org/ldes/0004/zittingen/1> a tree:Node .
v:2 dct:isVersionOf <http://ex.org/zitting/1> ;
  prov:generatedAtTime "2026-01-01T00:00:00.000Z"^^xsd:dateTime ;
  besluit:isGehoudenDoor <http://ex.org/orgaan-in-tijd/1> ;
  prov:wasDerivedFrom <http://ex.org/notulen> ;
  besluit:behandelt <http://ex.org/agendapunt/1> .
<http://ex.org/agendapunt/1> dct:title "Budget"@nl ;
  besluit:geplandOpenbaar true ;
  prov:wasDerivedFrom <http://ex.org/notulen> .
<http://ex.org/behandeling/1> a besluit:BehandelingVanAgendapunt ;
  dct:subject <http://ex.org/agendapunt/1> ;
  besluit:openbaar true ;
  besluit:heeftStemming <http://ex.org/stemming/1> ;
  prov:wasDerivedFrom <http://ex.org/notulen> .
